<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 서버(rel_ 함수)·새 버전 확인 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 통화가 끝났는지 알기(번호는 안 읽음) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- 폰 통화 기록: 번호·걸었나/받았나·시각·통화 시간만. 녹음·내용은 안 읽음 -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- 선택: 연락처 번호를 제외 목록에 넣을 때, 알림에 연락처 이름 보여 줄 때 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 통화가 끝나면 화면 아래 작은 창으로 묻기(다른 앱 위에 표시) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 스스로 업데이트(업무 기록 앱과 같은 방식) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:label="관계 기록"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 통화 끝나면 뜨는 작은 창: 이름·영역 고르고 바로 저장 -->
        <activity
            android:name=".AskActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar"
            android:taskAffinity="app.relrecord.ask"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- 통화가 끝나면 통화 기록 읽기 예약 -->
        <receiver android:name=".CallReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- 알림 [아님] · 업데이트·재부팅 뒤 다시 걸기 -->
        <receiver android:name=".AskReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CallJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver android:name=".UpdateReceiver" android:exported="false" />
    </application>
</manifest>
